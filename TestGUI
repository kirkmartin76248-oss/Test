    # --- THREAD BRIDGES ---
    def safe_log(self, msg, tags=None):
        self.log_history.append((msg, tags))
        self.root.after(0, lambda: (self.results_text.insert(tk.END, msg, tags), self.results_text.see(tk.END)))
    def safe_clear_log(self):
        self.log_history = []
        self.root.after(0, lambda: self.results_text.delete(1.0, tk.END))
    def safe_prog(self, val, max_val=None, mode=None):
        def _up():
            if max_val is not None: self.progress["maximum"] = max_val
            if mode: 
                self.progress["mode"] = mode
                if mode == 'indeterminate': self.progress.start(10)
                else: self.progress.stop()
            self.progress["value"] = val
        self.root.after(0, _up)
    def safe_timer(self, txt):
        self.root.after(0, lambda: self.timer_label.config(text=txt))
    def safe_ui(self, enable):
        state = "normal" if enable else "disabled"
        self.root.after(0, lambda: self.open_btn.config(state=state))
