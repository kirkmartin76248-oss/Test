    # ==========================================================================
    # EXECUTION ENGINE
    # ==========================================================================

    def make_test(self):
        self.seq_setup = []
        self.seq_test = []
        self.seq_cleanup = []
        def fill_queue(source, target, phase):
            for f in source:
                subs = self.extract_subtests(f)
                if subs:
                    for s in subs: target.append((f, s, phase))
                else:
                    target.append((f, "Main", phase))
        fill_queue(self.setup_list, self.seq_setup, "Setup")
        fill_queue(self.test_list, self.seq_test, "Test")
        fill_queue(self.cleanup_list, self.seq_cleanup, "Cleanup")
        total = len(self.seq_setup) + len(self.seq_test) + len(self.seq_cleanup)
        self.safe_log(f"Plan: {total} steps (S:{len(self.seq_setup)} T:{len(self.seq_test)} C:{len(self.seq_cleanup)})\n", "info")

    def run_tests_thread(self):
        if self.running: return
        self.running = True
        self.make_test()
        threading.Thread(target=self.execute_tests, daemon=True).start()

    def cancel_tests(self):
        self.running = False
        self.safe_log("\n>>> STOPPING <<<\n", "fail")

    def execute_tests(self):
        self.safe_clear_log()
        self.log_history = []
        self.safe_ui(False)
        self.test_data = [] 
        self.main_pass_count = 0
        self.main_fail_count = 0
        
        loop_type = self.loop_var.get()
        try: count_limit = int(self.loop_count.get())
        except: count_limit = 1
        
        s_str = self.start_time.get()
        if loop_type == "time" and s_str:
            try:
                s_dt = datetime.strptime(s_str, "%Y-%m-%d %H:%M")
                if s_dt > datetime.now():
                    self.safe_log(f"Waiting for {s_dt}...\n", "info")
                    self.safe_prog(0, mode="indeterminate")
                    while self.running and datetime.now() < s_dt:
                        rem = int((s_dt - datetime.now()).total_seconds())
                        self.safe_timer(f"Starts in: {rem}s")
                        time.sleep(0.5)
            except: pass

        self.execution_start_dt = datetime.now()
        self.safe_prog(0, mode="determinate")
        
        e_str = self.end_time.get()
        end_dt = None
        if loop_type == "time" and e_str:
            try:
                end_dt = datetime.strptime(e_str, "%Y-%m-%d %H:%M")
                total = (end_dt - self.execution_start_dt).total_seconds()
                self.safe_prog(0, max_val=max(total, 1))
            except: pass
        else:
            # PERCENTAGE
            self.safe_prog(0, max_val=100)
            has_setup = len(self.seq_setup) > 0
            has_cleanup = len(self.seq_cleanup) > 0
            share_setup = 10.0 if has_setup else 0.0
            share_cleanup = 10.0 if has_cleanup else 0.0
            share_tests = 100.0 - share_setup - share_cleanup
            eff_loops = count_limit if loop_type == "count" else 1
            inc_setup = share_setup
            inc_cleanup = share_cleanup
            total_test_steps = len(self.seq_test) * eff_loops
            inc_per_test = share_tests / total_test_steps if total_test_steps > 0 else 0
            self.current_progress_val = 0.0

        self.update_ui_loop()

        # SETUP
        if self.seq_setup and self.running:
            self.safe_log("\n--- Setup Phase ---\n", "phase")
            for item in self.seq_setup:
                if not self.running: break
                self.run_step_wrapper(item, "Setup")
            if loop_type != "time":
                self.current_progress_val += inc_setup
                self.safe_prog(self.current_progress_val)

        # LOOP
        iteration = 0
        while self.running:
            if loop_type == "none" and iteration >= 1: break
            if loop_type == "count" and iteration >= count_limit: break
            if loop_type == "time" and end_dt and datetime.now() > end_dt: break
            
            self.safe_log(f"\n=== Iteration {iteration + 1} ===\n", "iter")
            for item in self.seq_test:
                if not self.running: break
                self.run_step_wrapper(item, iteration + 1)
                if loop_type != "time":
                    self.current_progress_val += inc_per_test
                    self.safe_prog(self.current_progress_val)
            iteration += 1

        # CLEANUP
        if self.seq_cleanup and self.running:
            self.safe_log("\n--- Cleanup Phase ---\n", "phase")
            for item in self.seq_cleanup:
                if not self.running: break
                self.run_step_wrapper(item, "Cleanup")
            if loop_type != "time":
                self.current_progress_val += inc_cleanup
                self.safe_prog(self.current_progress_val)

        self.running = False
        self.execution_end_dt = datetime.now()
        self.safe_log("\n--- Finished ---\n", "pass")
        if loop_type != 'time': self.safe_prog(100)
        else: self.safe_prog(0)
        self.generate_report()
        self.safe_ui(True)

    def run_step_wrapper(self, item, iteration_val):
        fname, sub, phase = item
        if (sub in self.skipped_tests or f"{fname}:{sub}" in self.skipped_tests or fname in self.skipped_tests):
            self.safe_log(f"Skipped: {sub}\n", "skip")
            self.test_data.append({
                "Time": datetime.now().strftime("%H:%M:%S"), 
                "Iteration": str(iteration_val), "File": fname, "Test": sub, "Value": "N/A", 
                "Status": "SKIPPED", "Duration": "0.00s"
            })
            return
        self.run_single_test(fname, sub, phase, iteration_val)

    def update_ui_loop(self):
        if self.running:
            elapsed = datetime.now() - self.execution_start_dt
            txt = str(elapsed).split('.')[0]
            self.safe_timer(f"Elapsed: {txt}")
            if self.loop_var.get() == "time": self.progress["value"] = elapsed.total_seconds()
            self.root.after(100, self.update_ui_loop)

    def run_single_test(self, filename, subtest_string, phase_type, iteration_val):
        start_t = datetime.now()
        status = "FAIL"
        value = "Error"
        try:
            if os.getcwd() not in sys.path: sys.path.append(os.getcwd())
            mod_name = filename.replace('.py', '')
            spec = importlib.util.spec_from_file_location(mod_name, filename)
            if not spec or not spec.loader: raise ImportError("Load Fail")
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            parts = subtest_string.split(':')
            func_name = parts[0]
            args = []
            for a in parts[1:]:
                try: args.append(float(a) if '.' in a else int(a))
                except: args.append(a)
            self.safe_log(f"Exec: {func_name}{tuple(args)}...", "info")
            if hasattr(module, func_name):
                func = getattr(module, func_name)
                ret = func(*args) 
                captured_val = str(ret)
                is_success = False
                if isinstance(ret, (tuple, list)) and len(ret) == 2:
                    captured_val = ret[0]; is_success = ret[1]
                elif isinstance(ret, bool):
                    captured_val = str(ret); is_success = ret
                else:
                    captured_val = str(ret); is_success = True if ret is not None else False
                value = str(captured_val)
                if is_success:
                    status = "PASS"
                    self.safe_log(f" PASS ({value})\n", "pass")
                    self.main_pass_count += 1
                else:
                    status = "FAIL"
                    self.safe_log(f" FAIL ({value})\n", "fail")
                    self.main_fail_count += 1
                if "FATAL" in value.upper():
                    self.safe_log(f" >>> FATAL HALT <<<\n", "fail")
                    self.running = False
            elif subtest_string == "Main":
                status = "PASS"; value = "File Run"; self.safe_log(" OK\n", "pass"); self.main_pass_count += 1
            else:
                self.safe_log(f" FAIL (No Func)\n", "fail"); self.main_fail_count += 1
        except Exception as e:
            value = str(e); self.safe_log(f" CRASH: {e}\n", "fail"); self.main_fail_count += 1
        duration = (datetime.now() - start_t).total_seconds()
        self.test_data.append({
            "Time": datetime.now().strftime("%H:%M:%S"), "Iteration": str(iteration_val),
            "File": filename, "Test": subtest_string, "Value": value, "Status": status, "Duration": f"{duration:.2f}s"
        })

