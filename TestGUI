class DateTimePicker(tb.Toplevel):
    def __init__(self, parent, entry_widget):
        super().__init__(parent)
        self.title("Select Date/Time")
        self.entry = entry_widget
        self.geometry("300x180")
        
        tb.Label(self, text="Date & Time (YYYY-MM-DD HH:MM):", bootstyle="primary").pack(pady=(15, 5))
        self.picker = tb.Entry(self, width=25)
        self.picker.pack(pady=5)
        self.picker.insert(0, datetime.now().strftime("%Y-%m-%d %H:%M"))
        
        btn_frame = tb.Frame(self)
        btn_frame.pack(pady=15)
        tb.Button(btn_frame, text="Set Time", command=self.set_time, bootstyle="success").pack(side="left", padx=5)
        tb.Button(btn_frame, text="Cancel", command=self.destroy, bootstyle="secondary").pack(side="left", padx=5)

    def set_time(self):
        self.entry.delete(0, tk.END)
        self.entry.insert(0, self.picker.get())
        self.destroy()

