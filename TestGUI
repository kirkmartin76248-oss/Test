        self.tree_req.heading("Type", text="Type"); self.tree_req.column("Type", width=100)
        self.tree_req.pack(fill="both", expand=True)

        for item in current_data.get("requirements", []): self.tree_req.insert("", "end", values=item)

        # Footer
        tb.Button(main_pad, text="Save & Close", bootstyle="success", command=self.save_and_close).pack(pady=10)

    # --- Equipment Logic ---
    def add_equip(self):
        vals = [self.eq_widgets[f].get() for f in ["Description", "Asset ID", "MFR", "Model", "Cal Due"]]
        if any(vals):
            self.tree_eq.insert("", "end", values=vals)
            for w in self.eq_widgets.values(): w.delete(0, tk.END)
    
    def remove_equip(self):
        sel = self.tree_eq.selection()
        if sel: self.tree_eq.delete(sel[0])

    # --- Requirements Logic ---
    def add_req(self):
        r_id = self.req_id.get()
        r_desc = self.req_desc.get()
        r_type = self.req_type.get()
        if r_id and r_desc:
            self.tree_req.insert("", "end", values=(r_id, r_desc, r_type))
            self.req_id.delete(0, tk.END)
            self.req_desc.delete(0, tk.END)

    def remove_req(self):
        sel = self.tree_req.selection()
        if sel: self.tree_req.delete(sel[0])

    def save_and_close(self):
        data = {
            "operator": self.vars["operator"].get(),
            "uut_pn": self.vars["uut_pn"].get(),
            "uut_sn": self.vars["uut_sn"].get(),
            "equipment": [],
            "requirements": []
        }
        for child in self.tree_eq.get_children():
            data["equipment"].append(self.tree_eq.item(child)["values"])
        for child in self.tree_req.get_children():
            data["requirements"].append(self.tree_req.item(child)["values"])
        
        self.callback(data)
        self.destroy()

