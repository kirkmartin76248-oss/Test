        req_cols = ["Req ID", "Description", "Type"]
        self.tree_req = ttk.Treeview(req_frame, columns=req_cols, show="headings", selectmode="browse", height=4)
        self.tree_req.heading("Req ID", text="Req ID"); self.tree_req.column("Req ID", width=100)
