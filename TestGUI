    def configure_tags(self, widget):
        widget.tag_config("pass", foreground="#28a745")
        widget.tag_config("fail", foreground="#dc3545")
        widget.tag_config("skip", foreground="#f39c12")
        widget.tag_config("info", foreground="#17a2b8")
        widget.tag_config("iter", foreground="#17a2b8", font=("Consolas", 10, "bold"))
        widget.tag_config("phase", foreground="#6c757d", font=("Consolas", 10, "bold"))

    def rebuild_log_content(self, target_widget):
        self.configure_tags(target_widget)
        self.apply_theme_colors(target_widget)
        target_widget.delete("1.0", "end")
        for msg, tags in self.log_history:
            target_widget.insert("end", msg, tags)
        target_widget.see("end")

    def pop_out_log(self):
        if self.log_window is not None:
            self.log_window.lift()
            return
        self.log_window = tb.Toplevel(self.root)
        self.log_window.title("Status Log (Detached)")
        self.log_window.geometry("700x600")
        self.log_window.protocol("WM_DELETE_WINDOW", self.dock_log)
        f = tb.Frame(self.log_window)
        f.pack(fill="both", expand=True, padx=10, pady=10)
        scr = tb.Scrollbar(f, orient="vertical")
        scr.pack(side="right", fill="y")
        self.text_detached = tb.Text(f, font=("Consolas", 11), yscrollcommand=scr.set)
        self.text_detached.pack(side="left", fill="both", expand=True)
        scr.config(command=self.text_detached.yview)
        self.rebuild_log_content(self.text_detached)
        self.results_text = self.text_detached
        self.log_frame_embedded.pack_forget()

    def dock_log(self):
        if self.log_window:
            self.results_text = self.text_embedded
            self.rebuild_log_content(self.text_embedded)
            self.log_frame_embedded.pack(fill="both", expand=True, before=self.mon_frame.winfo_children()[-1])
            self.log_window.destroy()
            self.log_window = None

    def apply_theme_colors(self, widget):
        is_dark = self.root.style.theme.name == 'superhero'
        if is_dark:
            widget.configure(bg="#2b3e50", fg="white", insertbackground="white")
        else:
            widget.configure(bg="white", fg="black", insertbackground="black")

    def toggle_theme(self):
        current = self.root.style.theme.name
        if current == 'cosmo':
            self.root.style.theme_use('superhero')
            self.theme_btn.configure(text="☀️ Light Mode", bootstyle="light-outline")
        else:
            self.root.style.theme_use('cosmo')
            self.theme_btn.configure(text="🌙 Dark Mode", bootstyle="dark-outline")
        self.apply_theme_colors(self.results_text)

    def update_file_list(self):
        self.file_listbox.delete(0, tk.END)
        try:
            files = [f for f in os.listdir('.') if f.endswith('.py') and f != os.path.basename(__file__)]
            for f in files: self.file_listbox.insert(tk.END, f)
        except Exception: pass

    def extract_subtests(self, filename):
        subtests = []
        try:
            if os.getcwd() not in sys.path: sys.path.append(os.getcwd())
            mod_name = filename.replace('.py', '')
            spec = importlib.util.spec_from_file_location(mod_name, filename)
            if spec and spec.loader:
                mod = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(mod)
                if hasattr(mod, 'get_subtests'):
                    subtests = mod.get_subtests()
        except Exception: pass
        return subtests

    def update_tree(self):
        for item in self.tree.get_children(): self.tree.delete(item)
        def add_sec(title, file_list, icon):
            if not file_list: return
            head = self.tree.insert("", "end", text=title, open=True, tags=('head',))
            for f in file_list:
                node = self.tree.insert(head, "end", text=f"{icon} {f}", open=True)
                subs = self.extract_subtests(f)
                if subs:
                    for s in subs: self.tree.insert(node, "end", text=f"   • {s}", tags=('sub',))
                else:
                    self.tree.insert(node, "end", text="   (No Subtests Detected)", tags=('gray',))
        add_sec("Setup", self.setup_list, "📄")
        add_sec("Test", self.test_list, "🧪")
        add_sec("Cleanup", self.cleanup_list, "🧹")
        self.tree.tag_configure('head', font=("Segoe UI", 9, "bold"))
        self.tree.tag_configure('sub', foreground="gray")

    def add_to_list(self, type_):
        f = self.get_sel()
        if f:
            getattr(self, f"{type_}_list").append(f)
            getattr(self, f"{type_}_listbox").insert(tk.END, f)
            self.update_tree()

    def remove_from_list(self, type_):
        box = getattr(self, f"{type_}_listbox")
        if box.curselection():
            i = box.curselection()[0]
            box.delete(i)
            del getattr(self, f"{type_}_list")[i]
            self.update_tree()

    def get_sel(self):
        try: return self.file_listbox.get(self.file_listbox.curselection()[0])
        except: return None

    def toggle_skipped(self):
        sel = self.tree.selection()
        if not sel: return
        item_id = sel[0]
        raw_text = self.tree.item(item_id, "text")
        is_skipping = "- Skipping" in raw_text
        clean_text = raw_text.replace(" - Skipping", "")
        db_id = clean_text.replace("   • ", "")
        for icon in ["📄 ", "🧪 ", "🧹 "]:
            db_id = db_id.replace(icon, "")
        if is_skipping:
            self.skipped_tests.discard(db_id)
            self.tree.item(item_id, text=clean_text)
