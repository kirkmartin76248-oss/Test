def on_click(event):
    col = tree.identify_column(event.x)
    if col == '#1':
        item = tree.identify_row(event.y)
        if not item:
            return
        values = tree.item(item)['values']
        if not values:
            return
            
        box = str(values[0]).strip()
        name = str(values[1]).strip()
        status = str(values[2]).strip() if len(values) > 2 else ""
        
        if item in checked:
            ch = checked[item]
            if ".robot" in name:
                new = '[x]' if not ch else '[ ]'
            elif '└' in box or '[' in box:
                new = '└[x]' if not ch else '└[ ]'
            else:                
                new = ''
                
            if '[x]' in new:
                checked[item] = True
                tree.item(item, values=(new, name, status), tags=("skip",))
            else:
                checked[item] = False
                tree.item(item, values=(new, name, status), tags=("noskip",))

def select_files():
    files = filedialog.askopenfilenames(filetypes=[('Robot files', '*.robot')])
    for f in files:
        if f in file_paths.values():
            continue
        try:
            tag = "parent"
            suite = TestSuiteBuilder().build(f)
            basename = os.path.basename(f)
            parent_iid = f
            tree.insert('', 'end', iid=parent_iid, values=('[ ]', basename, ''), tags=(tag,))
            checked[parent_iid] = False
            file_paths[parent_iid] = f
            if not suite.tests:
                messagebox.showwarning("Warning", f"No tests found in {basename}")
            for test in suite.tests:
                child_iid = f"{f}:{test.name}"
                check_value = '└[ ]' if test.tags else ''
                tree.insert(parent_iid, 'end', iid=child_iid, values=(check_value, f'  {test.name}', ''))
                if test.tags:
                    checked[child_iid] = False
            tree.item(parent_iid, open=True)
        except Exception as e:
            messagebox.showerror("Error", f"Failed to parse {f}: {str(e)}")

def delete_sel():
    for s in list(tree.selection()):
        for child in list(tree.get_children(s)):
            if child in checked:
                del checked[child]
            tree.delete(child)

        if s in file_paths:
            del file_paths[s]
        if s in checked:
            del checked[s]
            
        if tree.exists(s):
            tree.delete(s)
            
    tree.update_idletasks()

