# Real-Time Robot Framework Listener Component
# -------------------------------------------------------------------------
class LiveGuiListener:
    """Robot Framework Listener to push live execution events straight to the GUI."""
    ROBOT_LISTENER_API_VERSION = 2

    def __init__(self, console_widget, tree_widget, file_paths_dict, current_iter):
        self.console = console_widget
        self.tree = tree_widget
        self.file_paths = file_paths_dict
        self.iteration = current_iter

    def _append_to_console(self, label_text, value_text, status_tag):
        """Helper to unlock, write, scroll, and refresh the UI thread safely."""
        if abort_execution.get():
            return
            
        time_str = dt.datetime.now().strftime('%H:%M:%S')
        
        self.console.configure(state='normal')
        self.console.insert(tk.END, f"[{time_str}] ", "INFO")
        self.console.insert(tk.END, f"Iter {self.iteration} | ", "INFO")
        self.console.insert(tk.END, f"{label_text} ")
        self.console.insert(tk.END, f"{value_text}\n", status_tag)
        self.console.see(tk.END)
        self.console.configure(state='disabled')
        self.console.update_idletasks()

    def start_suite(self, name, attributes):
        if abort_execution.get():
            raise SystemExit("Execution explicitly killed by GUI operator.")
        self._append_to_console(f"SUITE: {name.upper()}", "TEST SUITE STARTED", "INFO")

    def start_test(self, name, attributes):
        if abort_execution.get():
            raise SystemExit("Execution explicitly killed by GUI operator.")

    def end_test(self, name, attributes):
        if abort_execution.get():
            return
            
        status = attributes['status']
        self._append_to_console(f"  Test: {name} Status:", status, status)
        
        for parent_iid in self.tree.get_children():
            file_path = self.file_paths.get(parent_iid, "")
            child_iid = f"{file_path}:{name}"
            if child_iid in self.tree.get_children(parent_iid):
                current_vals = self.tree.item(child_iid)['values']
                if current_vals:
                    skip_box = str(current_vals[0]).strip()
                    test_name = str(current_vals[1]).strip()
                    self.tree.item(child_iid, values=(skip_box, test_name, status), tags=(f"{status}_ROW",))
                self.tree.update_idletasks()

    def end_suite(self, name, attributes):
        if abort_execution.get():
            return
            
        status = attributes['status']
        for parent_iid in self.tree.get_children():
            file_path = self.file_paths.get(parent_iid, "")
            basename = os.path.splitext(os.path.basename(file_path))[0]
            basename_clean = basename.replace('_', ' ')
            if name.lower() == basename_clean.lower() or name.lower() == basename.lower():
                current_vals = self.tree.item(parent_iid)['values']
                if current_vals:
                    skip_box = str(current_vals[0]).strip()
                    suite_name = str(current_vals[1]).strip()
                    self.tree.item(parent_iid, values=(skip_box, suite_name, status), tags=(f"{status}_ROW",))
                self.tree.update_idletasks()

