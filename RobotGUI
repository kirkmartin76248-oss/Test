# -------------------------------------------------------------------------
def clear_treeview_statuses():
    """Clears out all status values and colors from the treeview map before running a new loop."""
    for parent_iid in tree.get_children():
        current_vals = tree.item(parent_iid)['values']
        if current_vals:
            skip_box = str(current_vals[0]).strip()
            suite_name = str(current_vals[1]).strip()
            tree.item(parent_iid, values=(skip_box, suite_name, ""), tags=("parent",))
            
        for child_iid in tree.get_children(parent_iid):
            child_vals = tree.item(child_iid)['values']
            if child_vals:
                c_skip_box = str(child_vals[0]).strip()
                c_test_name = str(child_vals[1]).strip()
                tag = "skip" if checked.get(child_iid, False) else "noskip"
                tree.item(child_iid, values=(c_skip_box, c_test_name, ""), tags=(tag,))
    tree.update_idletasks()

def run_one(iteration):
    ts = dt.datetime.now().strftime('%Y%m%d_%H%M%S')
    suffix = '' if iteration == 0 else f'-loop{iteration}'
    std = io.StringIO()
    
    live_listener = LiveGuiListener(console_log, tree, file_paths, iteration)
    
    # -------------------------------------------------------------------------
    # SECTION 1: MERGE TEST MODE (Run all files together)
    # -------------------------------------------------------------------------
    if merge_test.get():
        selected_files = []
        skipped_tests = []
        for parent in tree.get_children():
            if checked.get(parent, True):
                continue
            file = file_paths[parent]
            try:
                TestSuiteBuilder().build(file)
                skipped = [str(tree.item(child)['values'][1]).strip() for child in tree.get_children(parent) if checked.get(child, False)]
                skipped_tests.extend(f"{test_name}" for test_name in skipped)
                selected_files.append(file)
            except Exception as e:
                console_log.configure(state='normal')
                console_log.insert(tk.END, f"[ERROR] {file}: {str(e)}\n", "FAIL")
                console_log.configure(state='disabled')
                return
                
        if not selected_files:
            console_log.configure(state='normal')
            console_log.insert(tk.END, "[WARNING] No test targets selected for processing\n", "SKIP")
            console_log.configure(state='disabled')
            return
            
        # Define standard names so Robot Framework can compile successfully
        out_name = f'output-{ts}-merged{suffix}.xml'
        log_name = f'log-{ts}-merged{suffix}.html'
        rep_name = f'report-{ts}-merged{suffix}.html'
        
        # Save the path to the "View Last Report" button tracker variable
        last_report_path.set(rep_name)
            
        try:
            args = {
                'output': out_name, 'log': log_name, 'report': rep_name, 
                'stdout': std, 'listener': live_listener
            }
            if skipped_tests:
                args['skip'] = skipped_tests
            
            robot.run(*selected_files, **args)
            
            # FIXED: Direct post-run file cleanup based on user checkboxes
            if not generate_output.get() and os.path.exists(out_name):
                os.remove(out_name)
            if not generate_log.get() and os.path.exists(log_name):
                os.remove(log_name)
            if not generate_report.get() and os.path.exists(rep_name):
                os.remove(rep_name)
                
        except SystemExit:
            return
        except Exception as e:
            console_log.configure(state='normal')
            console_log.insert(tk.END, f"[ERROR] Merged suite execution failed: {str(e)}\n", "FAIL")
            console_log.configure(state='disabled')
            return

    # -------------------------------------------------------------------------
    # SECTION 2: NON-MERGE TEST MODE (Run each file separately)
    # -------------------------------------------------------------------------
    else:
        selected_files = []
        file_basenames = {}
        skipped_tests = {}
        for parent in tree.get_children():
            if checked.get(parent, True):
                continue
            file = file_paths[parent]
            try:
                skipped_tests[file] = [str(tree.item(child)['values'][1]).strip() for child in tree.get_children(parent) if checked.get(child, False)]
                selected_files.append(file)
                file_basenames[file] = os.path.splitext(os.path.basename(file))[0]
            except Exception as e:
                console_log.configure(state='normal')
                console_log.insert(tk.END, f"[ERROR] File execution path error: {str(e)}\n", "FAIL")
                console_log.configure(state='disabled')
                return
                
        if not selected_files:
            console_log.configure(state='normal')
            console_log.insert(tk.END, "[WARNING] No independent test targets selected\n", "SKIP")
            console_log.configure(state='disabled')
            return
            
        try:
            for file in selected_files:
                if abort_execution.get():
                    break
                    
                basename = file_basenames[file]
                
                # Define standard names so Robot Framework can compile successfully
                out_name = f'output-{ts}-{basename}{suffix}.xml'
                log_name = f'log-{ts}-{basename}{suffix}.html'
                rep_name = f'report-{ts}-{basename}{suffix}.html'
                
                # Save the path to the "View Last Report" button tracker variable
                last_report_path.set(rep_name)
                    
                args = {
                    'output': out_name, 'log': log_name, 'report': rep_name, 
                    'stdout': std, 'listener': live_listener
                }
                if skipped_tests[file]:
                    args['skip'] = skipped_tests[file]
                
                robot.run(file, **args)
                
                # FIXED: Direct post-run file cleanup based on user checkboxes
                if not generate_output.get() and os.path.exists(out_name):
                    os.remove(out_name)
                if not generate_log.get() and os.path.exists(log_name):
                    os.remove(log_name)
                if not generate_report.get() and os.path.exists(rep_name):
                    os.remove(rep_name)
                    
        except SystemExit:
            return
        except Exception as e:
            console_log.configure(state='normal')
            console_log.insert(tk.END, f"[ERROR] Execution pipeline faulted: {str(e)}\n", "FAIL")
            console_log.configure(state='disabled')
            return
            
    return std.getvalue() + '\n'

