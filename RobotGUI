def check_and_execute_timer_loop(start_dt, stop_dt, current_iteration=1):
    """Asynchronous loop checking calendar intervals without blocking the main UI thread."""
    if abort_execution.get():
        console_log.configure(state='normal')
        console_log.insert(tk.END, f"[{dt.datetime.now().strftime('%H:%M:%S')}] ", "INFO")
        console_log.insert(tk.END, "[ABORT] Scheduled execution window cancelled by operator request.\n", "FAIL")
        console_log.configure(state='disabled')
        btn_run.configure(state='normal')
        btn_stop.configure(state='disabled')
        return

    if not use_loop.get() or loop_var.get() != 1:
        btn_run.configure(state='normal')
        btn_stop.configure(state='disabled')
        return 

    now = dt.datetime.now()

    if now < start_dt:
        seconds_left = int((start_dt - now).total_seconds())
        console_log.configure(state='normal')
        console_log.delete("1.0", tk.END)
        console_log.insert(tk.END, f"[{now.strftime('%H:%M:%S')}] [INFO] Waiting for scheduled time to start... ({seconds_left}s remaining)\n", "INFO")
        console_log.configure(state='disabled')
        root.after(1000, lambda: check_and_execute_timer_loop(start_dt, stop_dt, current_iteration))
        return

    if now < stop_dt:
        global test_thread
        if test_thread and test_thread.is_alive():
            root.after(500, lambda: check_and_execute_timer_loop(start_dt, stop_dt, current_iteration))
            return

        iter_var.set(f"Iteration: {current_iteration}")
        root.update_idletasks()
        
        clear_treeview_statuses()
        
        test_thread = threading.Thread(target=run_one, args=(current_iteration,), daemon=True)
        test_thread.start()
        
        root.after(1000, lambda: check_and_execute_timer_loop(start_dt, stop_dt, current_iteration + 1))
        return

    console_log.configure(state='normal')
    console_log.insert(tk.END, f"[{dt.datetime.now().strftime('%H:%M:%S')}] [INFO] Scheduled window complete. Reached stop threshold at: {stop_dt.strftime('%H:%M:%S')}\n", "INFO")
    console_log.configure(state='disabled')
    btn_run.configure(state='normal')
    btn_stop.configure(state='disabled')


def run_count_loop(total_loops, current_iteration=1):
    """Executes a count-based loop using clean UI intervals, checking completion
    statically after thread workflows complete instead of firing prematurely."""
    global test_thread
    
    if abort_execution.get():
        console_log.configure(state='normal')
        console_log.insert(tk.END, f"[{dt.datetime.now().strftime('%H:%M:%S')}] ", "INFO")
        console_log.insert(tk.END, "[ABORT] Loop execution block halted by operator request.\n", "FAIL")
        console_log.configure(state='disabled')
        btn_run.configure(state='normal')
        btn_stop.configure(state='disabled')
        return

    if test_thread and test_thread.is_alive():
        root.after(200, lambda: run_count_loop(total_loops, current_iteration))
        return

    if current_iteration > total_loops:
        time_str = dt.datetime.now().strftime('%H:%M:%S')
        console_log.configure(state='normal')
        console_log.insert(tk.END, f"[{time_str}] ", "INFO")
        console_log.insert(tk.END, "[INFO] Multi-loop iteration limit completed.\n", "INFO")
        console_log.see(tk.END)
        console_log.configure(state='disabled')
        btn_run.configure(state='normal')
        btn_stop.configure(state='disabled')
        return

    iter_var.set(f"Iteration: {current_iteration}")
    root.update_idletasks()
    
    clear_treeview_statuses()
    
    test_thread = threading.Thread(target=run_one, args=(current_iteration,), daemon=True)
    test_thread.start()
    
    root.after(500, lambda: run_count_loop(total_loops, current_iteration + 1))
    
def check_single_run_completion():
    """Polls a standard single run task context to restore widget states dynamically."""
    global test_thread
    if test_thread and test_thread.is_alive():
        root.after(200, check_single_run_completion)
        return
    btn_run.configure(state='normal')
    btn_stop.configure(state='disabled')
    
def open_last_report():
    """Dynamically opens the most recently generated HTML report inside the system's default web browser."""
    report_file = last_report_path.get()
    if not report_file or report_file == "NONE" or not os.path.exists(report_file):
        messagebox.showinfo("Report Monitor", "No valid report file has been generated yet during this execution cycle.")
        return
        
    import webbrowser
    # Convert local absolute file system notation into a browser-safe URL string path
    webbrowser.open(os.path.abspath(report_file))

def run_tests():
    global test_thread
    abort_execution.set(False)
    
    console_log.configure(state='normal')
    console_log.delete("1.0", tk.END)
    console_log.configure(state='disabled')
    
    use = use_loop.get()
    if use:
        if loop_var.get() == 0:  # Count-based loop mode
            try:
                num = int(num_loops.get() or '1')
                btn_run.configure(state='disabled')
                btn_stop.configure(state='normal')
                run_count_loop(num, 1)
            except ValueError:
                messagebox.showerror("Configuration Error", "Loop limit must be a valid whole number.")
                return
        else:  # Time-window lock loop mode
            start_str = start_entry.get().strip()
            stop_str = stop_entry.get().strip()
            if not start_str or not stop_str:
                messagebox.showerror("Configuration Error", "Both Start and Stop parameters are required.")
                return
            try:
                start_dt = dt.datetime.strptime(start_str, '%Y-%m-%d %H:%M')
                stop_dt = dt.datetime.strptime(stop_str, '%Y-%m-%d %H:%M')
                
                if stop_dt <= start_dt:
                    messagebox.showerror("Configuration Error", "Stop target window must be set after the Start window constraint.")
                    return
                
                btn_run.configure(state='disabled')
                btn_stop.configure(state='normal')
                check_and_execute_timer_loop(start_dt, stop_dt, 1)
                
            except ValueError:
                messagebox.showerror("Configuration Error", "Invalid date/time format. Use YYYY-MM-DD HH:MM")
                return
    else:  # Standard single run execution
        btn_run.configure(state='disabled')
        btn_stop.configure(state='normal')
        
        iter_var.set("Iteration: 1")
        root.update_idletasks()
        clear_treeview_statuses()
        
        test_thread = threading.Thread(target=run_one, args=(1,), daemon=True)
        test_thread.start()
        
        root.after(200, check_single_run_completion)


def trigger_immediate_stop():
    """Signals an internal abort request to break processing loops instantly."""
    abort_execution.set(True)
    console_log.configure(state='normal')
    console_log.insert(tk.END, f"[{dt.datetime.now().strftime('%H:%M:%S')}] ", "INFO")
    console_log.insert(tk.END, "[SYSTEM ALERT] Stop requested. Gracefully breaking execution channel...\n", "FAIL")
    console_log.configure(state='disabled')
    btn_stop.configure(state='disabled')
    root.update_idletasks()


